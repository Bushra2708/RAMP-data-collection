# --- Core Server Configurations ---
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database Configurations ---
# Connection string to Neon PostgreSQL or local PostgreSQL instance
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# --- Authentication Configurations ---
# Strong secret key for signing JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here

# --- Cloud Storage Option A: AWS S3 ---
# Configure these to enable direct uploads to AWS S3 buckets (takes priority)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_s3_bucket_name

# --- Cloud Storage Option B: Cloudinary ---
# Configure these to use Cloudinary cloud storage (fallback if S3 variables are empty)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret
